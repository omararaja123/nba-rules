# NBA Rules RAG - Environment Configuration Template
#
# IMPORTANT: Copy this file to .env and add your actual API key
# The .env file is gitignored and should NEVER be committed
#
# To use:
#   1. Copy this file: cp .env.example .env
#   2. Add your API key: edit .env and fill in the value
#   3. Run scripts that need the API key
#

# Anthropic API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: LLM Model Selection
# Default is claude-opus-4-1-20250805
# Other options: claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-opus-4-1-20250805

# Optional: API Endpoint
# Default is the official Anthropic API
ANTHROPIC_API_ENDPOINT=https://api.anthropic.com

